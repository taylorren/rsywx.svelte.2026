# RSYWX API — server-only environment variables
# Copy this file to `.env` (or `.env.local`) and fill in real values.
#
#   cp .env.example .env.local
#
# These are read ONLY on the server (in +page.server.ts / server loaders),
# never shipped to the browser.

# API key for the RSYWX backend. Required in production.
RSYWX_API_KEY=

# Base URL of the versioned API. Defaults to https://api.rsywx.com/api/v1
# RSYWX_API_BASE=https://api.rsywx.com/api/v1

# The site language (affects <html lang> and copy).
# RSYWX_LANG=zh